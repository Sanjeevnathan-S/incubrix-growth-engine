# ==========================================
# API CREDENTIALS
# ==========================================
# YouTube Data API v3 Key (Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_keys_here

# Gemini API Key for Semantic Classification (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_keys_here

# Note: Podcast discovery uses the public Apple Podcasts API & RSS feeds (no API key required)

# ==========================================
# FILE PATHS & DATABASE
# ==========================================
DATABASE_PATH=data/cache.db
OUTPUT_CSV_PATH=data/processed/leads.csv
WORKBOOK_TEMPLATE_PATH=data/Template.xlsx
LOG_FILE_PATH=logs/error.log

# ==========================================
# PIPELINE CONFIGURATION & THRESHOLDS
# ==========================================
TARGET_LEADS_COUNT=1200
ALLOWED_COUNTRIES=US,CA,GB,IE,AU,NZ,SG
MIN_POSTS_LAST_30_DAYS=8
MIN_LONGFORM_LAST_60_DAYS=2
LONGFORM_MIN_DURATION_SECONDS=600
LLM_MODEL_NAME=gemini-2.5-flash-lite,gemini-2.5-flash
BATCH_SIZE=15